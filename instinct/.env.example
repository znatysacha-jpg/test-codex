# Copiez ce fichier en .env pour un essai local. Ne commitez JAMAIS le fichier .env.

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Remplis automatiquement par scripts/provision.py (state.json), ou à copier ici :
AGENT_ID=
ENVIRONMENT_ID=
MEMORY_STORE_ID=
# Secret de signature du webhook créé dans la console (Manage > Webhooks), commence par whsec_
ANTHROPIC_WEBHOOK_SIGNING_KEY=
# Plafond de dépense par conversation, en centimes de dollar (0 = aucun). Ex. 2000 = 20 $
SESSION_BUDGET_CENTS=0
# Plafond de dépense par tâche planifiée (lu par provision.py). 200 = 2 $
DEPLOYMENT_BUDGET_CENTS=200

# --- Dépôt GitHub monté dans chaque session : il apporte les 147 skills ---
GITHUB_REPO_URL=https://github.com/znatysacha-jpg/test-codex
GITHUB_BRANCH=main
# Jeton GitHub « fine-grained », accès en lecture seule (Contents: Read) à ce dépôt uniquement
GITHUB_TOKEN=

# --- Telegram (canal principal) ---
TELEGRAM_BOT_TOKEN=
# Chaîne aléatoire de votre choix (lettres, chiffres, _ et -)
TELEGRAM_WEBHOOK_SECRET=
# Votre identifiant Telegram numérique (envoyez un message à @userinfobot pour le connaître)
OWNER_TELEGRAM_ID=

# --- WhatsApp (optionnel) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Votre numéro, au format international sans + (ex. 33612345678)
OWNER_WHATSAPP_NUMBER=

# --- Google (Gmail + Agenda) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- App iPhone (connecteur claude.ai) et Siri ---
# Longues chaînes aléatoires : python -c "import secrets;print(secrets.token_urlsafe(32))"
# Le connecteur s'ajoute dans claude.ai avec l'URL https://<passerelle>/mcp/<MCP_SECRET>/
MCP_SECRET=
SIRI_TOKEN=

# --- Divers ---
DEFAULT_CHANNEL=telegram
PUBLIC_BASE_URL=
TIMEZONE=Europe/Paris
